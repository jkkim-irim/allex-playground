<mujoco model="ALLEX game level0 physics-only">
  <!-- GENERATED by tools/make_physics_only.py -- do not edit.
       Visual geoms and their mesh assets stripped; collision only. -->

  <!-- Game scene: ALLEX grounded on its mount, with a work surface and props.
       Lives beside ALLEX.xml so `meshdir="../meshes"` resolves identically.

       ALLEX.xml is generated from an internal SSoT and must not be edited by
       hand, so every game-side change belongs here. Two things this scene adds
       that the bare scene.xml does not:

       1. A mount, and the height convention. World z is HEIGHT ABOVE THE FLOOR
          here: floor 0, robot base 0.600, bench top surface 0.850. ALLEX.xml
          welds Base_Link to the world at z=0 and is generated, so the robot is
          lifted to 0.6 in code instead -- see BASE_HEIGHT in web/src/main.js.
          MJCF has no way to offset or override an <include>, which is why this
          cannot live in the XML. The mount fills floor to base; without it the
          robot visibly floats.

       2. contype/conaffinity 7/7 on every prop. `L_Thumb_Proximal_Collision1`
          carries contype="2" conaffinity="4"; a prop with MuJoCo's default 1/1
          fails both (1&4)==0 and (2&1)==0, so it would silently pass through
          that link. 7/7 collides with everything. -->

  <include file="ALLEX_slim.xml"/>

  <!-- Gravity stated rather than inherited, and the timestep set here so the scene
       owns its own rate: 1/240 s, i.e. 240 Hz physics. The render loop runs at 60 Hz
       and takes exactly 4 substeps per frame, which is what makes 240 Hz real time.

       MuJoCo has no internal substepping -- opt.timestep IS the integration step, and
       calling mj_step four times advances four full steps. That is why 240 Hz needs
       timestep 1/240 and not 1/120: engines like PhysX subdivide a frame dt internally,
       MuJoCo does not.

       240 Hz is also what makes the contact time constant legal. A solref time constant
       should be at least 2*timestep; at 1/240 that is 0.00833, and the contact constant
       is 0.01. At 1/120 the bar was 0.0167 and 0.01 fell short of it -- measured, that
       cost 22.4 mm of penetration against 5.8 mm here. -->
  <option gravity="0 0 -9.81" timestep="0.0041667"/>

  <!-- Solver arena, sized with deliberate margin so nothing can ever be dropped for want
       of space. Note njmax and nconmax are NOT the knobs any more: MuJoCo 3 removed both
       (they read back as -1 on this build, 3.10.0) and replaced them with this single
       dynamically-partitioned arena, which is why they are not written here -- the
       compiler rejects them outright.
       Measured peak over a deliberately worst-case run -- grasp the cylinder, jam it into
       the bin, then drive the arm into the torso and up under the head -- was ncon 34,
       nefc 253, 0.2 MB of arena. Auto-sizing already gave 19 MB, so 32 MB is roughly 160x
       the observed high-water mark. mjWARN_CONTACTFULL and mjWARN_CNSTRFULL have never
       fired. This is headroom for the unmeasured case, not a fix for a seen failure. -->
  <size memory="32M"/>

  <statistic center="0.15 0 0.95" extent="1.5"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.13 0.17 0.22 1"/>
    <global azimuth="140" elevation="-18" offwidth="1600" offheight="1200"/>
    <quality shadowsize="4096"/>
    <map shadowclip="2.0"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.22 0.28 0.36"
             rgb2="0.03 0.04 0.06" width="512" height="3072"/>
    <texture type="2d" name="floor_tex" builtin="checker" mark="edge"
             rgb1="0.17 0.19 0.22" rgb2="0.12 0.14 0.16"
             markrgb="0.35 0.37 0.40" width="300" height="300"/>
    <material name="floor_mat" texture="floor_tex" texuniform="true"
              texrepeat="6 6" reflectance="0.08"/>
    <material name="mount_mat" rgba="0.20 0.21 0.24 1" reflectance="0.05"/>
    <material name="bench_mat" rgba="0.55 0.42 0.28 1" reflectance="0.02"/>
    <material name="prop_red" rgba="0.82 0.28 0.22 1"/>
    <material name="prop_blue" rgba="0.24 0.45 0.78 1"/>
    <material name="prop_green" rgba="0.32 0.62 0.36 1"/>
    <material name="prop_yellow" rgba="0.88 0.72 0.20 1"/>
  </asset>

  <default>
    <default class="prop">
      <!-- 7/7 so props collide with every hand geom, including the thumb
           proximal link's non-default contype=2/conaffinity=4 -->
      <geom contype="7" conaffinity="7" friction="0.7 0.02 0.001"
            solimp="0.999 0.9999 0.0001" solref="0.004 1" condim="4"/>
    </default>
    <default class="static">
      <geom type="box" contype="7" conaffinity="7" friction="0.7 0.02 0.001"/>
    </default>
    <!-- Shared tuning for every frozen joint. solref timeconst must stay
         >= 2*timestep (0.002) or the constraint rings; 0.004 is the tightest
         stable value measured here. -->
    <default class="frozen">
      <equality solref="0.004 1" solimp="0.99 0.9999 0.001"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.6 0.4 2.8" dir="-0.2 -0.15 -1" directional="true"
           diffuse="0.5 0.5 0.5" specular="0.15 0.15 0.15" castshadow="true"/>
    <light pos="-0.8 -0.8 2.2" dir="0.3 0.3 -1" directional="true"
           diffuse="0.18 0.18 0.22" castshadow="false"/>

    <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane"
          material="floor_mat" contype="7" conaffinity="7"/>

    <!-- Mount: fills the 0.685 m between the floor and the welded Base_Link.
         Column half-width is 0.11, not 0.16: the arms hang past the base and the
         outer fingers sit at |y| ~ 0.154, so a 0.16 column swallowed them. That
         showed up as 20+ resting contacts and up to -33 mm of penetration
         between mount_column and the little fingers -- present since this scene
         was written, just never looked at. The robot's own base is only
         +/-0.075 wide, so 0.11 still clears it comfortably. -->
    <body name="mount" pos="0 0 0.3">
      <geom class="static" name="mount_column" size="0.11 0.11 0.3"
            material="mount_mat"/>
      <geom class="static" name="mount_foot" pos="0 0 -0.29"
            size="0.26 0.26 0.01" material="mount_mat"/>
    </body>

    <!-- Work surface in front of the robot (+x is forward; the head cameras
         sit at +x offsets). Top face at z = 0.15. -->
    <body name="bench" pos="0.52 0 0.7">
      <geom class="static" name="bench_top" pos="0 0 0.135"
            size="0.24 0.45 0.015" material="bench_mat"/>
      <geom class="static" name="bench_leg_l" pos="0 0.38 -0.28"
            size="0.03 0.03 0.4" material="mount_mat"/>
      <geom class="static" name="bench_leg_r" pos="0 -0.38 -0.28"
            size="0.03 0.03 0.4" material="mount_mat"/>
    </body>

    <!-- Two props, resting on the bench top (z = 0.15): one cylinder to pick and
         one open bin to put it in.

         The cylinder's 48 mm diameter is sized from the hand's own finger cage,
         measured on this model as the distance between distal-link origins while
         driving the grip synergy (so the enclosed diameter is smaller than these
         spans by roughly a finger thickness at each pad):

           synergy   thumb-index   thumb-middle   thumb-ring
             0.45       80.3 mm       100.2 mm      121.3 mm
             0.60       62.3 mm        81.2 mm      101.6 mm
             0.75       49.4 mm        65.8 mm       84.7 mm
             0.90       40.6 mm        53.3 mm       70.5 mm
             1.00       36.5 mm        46.8 mm       63.3 mm

         48 mm sits inside the thumb-middle span at roughly synergy 0.75-0.8, so
         the fingers wrap it rather than closing past it in the air (what the old
         50-66 mm props did) or bottoming out early. It is deliberately larger
         than the 36 mm can it replaces -- a wider cylinder gives the fingers more
         surface to oppose, which is the "easy to grasp" part of the request.
         125 mm tall (1.25x the original 100) keeps a 2.6:1 aspect, still stable
         standing and tall enough to grab well clear of the bench.

         The bin is a free body, not static, because it is one of the two objects
         here rather than scenery -- it can be shoved and repositioned. 0.5 kg
         keeps it from sliding on an accidental brush.

         Interior is 143 x 143 x 110 mm: the footprint went up 1.1x and the walls
         DOUBLED from 55 mm. 55 mm was low enough against a 125 mm cylinder that
         players tipped it in over the side instead of lowering it, which is a
         different task from the one being scored. 110 mm is most of the
         cylinder's length, so it has to go in upright or not at all.

         Both sit in the band both arms can serve. Measured position error for a
         release point 0.28 m up, sweeping bin y at x=0.52:

              y     left hand   right hand
            +0.30      0.0 mm     117.7 mm
            +0.20      0.0 mm      39.4 mm
            +0.10      0.0 mm       0.1 mm
             0.00      0.1 mm       0.0 mm
            -0.10      0.1 mm       0.0 mm
            -0.18     27.8 mm       0.0 mm
            -0.30    117.7 mm       0.0 mm

         Only |y| <= 0.10 is shared. The first placement put the bin at y = -0.18,
         where the default left hand was already 21.6 mm short and visibly straining
         across the body; at these positions both hands reach both objects to within
         0.1 mm, so either arm can run the whole pick-and-place. -->
    <body name="prop_cylinder" pos="0.53 -0.17 0.9130">
      <freejoint name="prop_cylinder_free"/>
      <geom class="prop" name="prop_cylinder_g" type="cylinder"
            size="0.024 0.0625" mass="0.10" material="prop_blue"/>
    </body>

    <!-- Level 0's T block. Two boxes in one body, so MuJoCo excludes the pair where
         they meet automatically.

         80 x 80 mm footprint, 25 mm tall. Laid out so the pieces actually touch:
         the bar spans y 0.015..0.040 and the stem y -0.040..0.015, meeting at 0.015.
         An earlier arrangement centred the stem at -0.0275 and left a 15 mm gap
         between the two halves -- a T in two disconnected pieces.

         Origin is the body centre, so pos z = bench top + half the height. Both
         levels' props live in the scene at once and the inactive set is parked below
         the floor with its collisions switched off in code; a second MJCF would mean
         a second compile and a second 4 MB of meshes on every level change. -->
    <body name="prop_tblock" pos="0.53 -0.17 0.8625">
      <freejoint name="prop_tblock_free"/>
      <geom class="prop" name="prop_tblock_bar" type="box"
            size="0.040 0.0125 0.0125" pos="0 0.0275 0"
            mass="0.040" material="prop_blue"/>
      <geom class="prop" name="prop_tblock_stem" type="box"
            size="0.0125 0.0275 0.0125" pos="0 -0.0125 0"
            mass="0.030" material="prop_blue"/>
    </body>

    <body name="prop_bin" pos="0.46 -0.01 0.8505">
      <freejoint name="prop_bin_free"/>
      <!-- Origin is the underside of the floor, so pos z = bench top exactly.
           Corner overlap between the walls is harmless: same body, so MuJoCo
           excludes those pairs automatically. -->
      <geom class="prop" name="prop_bin_floor" type="box"
            size="0.0795 0.0795 0.004" pos="0 0 0.004"
            mass="0.20" material="prop_yellow"/>
      <geom class="prop" name="prop_bin_wall_px" type="box"
            size="0.004 0.0795 0.055" pos="0.0755 0 0.063"
            mass="0.075" material="prop_yellow"/>
      <geom class="prop" name="prop_bin_wall_nx" type="box"
            size="0.004 0.0795 0.055" pos="-0.0755 0 0.063"
            mass="0.075" material="prop_yellow"/>
      <geom class="prop" name="prop_bin_wall_py" type="box"
            size="0.0795 0.004 0.055" pos="0 0.0755 0.063"
            mass="0.075" material="prop_yellow"/>
      <geom class="prop" name="prop_bin_wall_ny" type="box"
            size="0.0795 0.004 0.055" pos="0 -0.0755 0.063"
            mass="0.075" material="prop_yellow"/>
    </body>

    <!-- Spectator cameras. mode="targetbody" aims them automatically, which is
         far less error-prone than hand-computing xyaxes. -->
    <camera name="game_front" pos="1.9 0 1.35"
            mode="targetbody" target="Chest_Origin_Link"/>
    <camera name="game_over_shoulder" pos="-0.75 0.85 1.95"
            mode="targetbody" target="Chest_Origin_Link"/>
    <camera name="game_bench" pos="1.15 0.30 1.28"
            mode="targetbody" target="bench"/>
  </worldbody>

  <!-- The head is a sensor mount in this game, not something the player drives, so
       its pitch is welded rather than servoed.

       It cannot be left to the actuator. Neck_Pitch_Joint carries
       actuatorfrcrange="-12 12" -- weak by design on the real robot -- and the arm
       overpowers it: driving a hand to its default target brings L_Upper_Arm_Link
       against Neck_Yaw_Link and the head was batted from -44.8 to +50.6 deg,
       through BOTH joint limits (MuJoCo limits are soft), while ctrl sat correctly
       at 30 deg and the servo saturated. The first-person camera rides on this
       joint, so the view swung with it.

       A joint equality with joint2 omitted holds joint1 at qpos0 + polycoef[0];
       qpos0 is 0 here, so this is a hard 30 deg = 0.5235988 rad. Doing it in the
       model rather than by overwriting qpos each frame keeps nq/nv/nu identical to
       the real robot -- which matters, because recorded joint trajectories are the
       point of this project -- and lets the constraint solver put the reaction
       into the arm instead of silently violating momentum.

       solref timeconst must stay >= 2*timestep (0.002) or the constraint rings;
       0.004 is the tightest stable value here.

       Yaw is welded too, at 0. Welding pitch alone is not enough: with the head
       no longer free to pitch away, the same arm contact twisted it 74.7 deg in
       yaw and left it sitting at -59 deg -- a first-person camera aimed most of
       the way over one shoulder. Neck_Yaw_Joint is weaker still
       (actuatorfrcrange="-6 6"), so its servo loses the same argument. "Fixed
       neck" has to mean both axes. -->
  <!-- The 0-90 deg limit on the coupled distal joints (R_*_DIP, R_Thumb_IP) is NOT here.
       It is applied in code -- see clampDistals() in web/src/main.js.
       Those five joints ship with nothing in ALLEX.xml: no range, no actuator, no
       armature, no frictionloss, no damping. The only thing holding them is the coupling
       equality, which is a SOFT constraint, so a contact on a fingertip has nothing hard
       to push against. Measured: closing the hand in air levers R_Thumb_IP to -84 deg and
       it stays there, 136.8 deg away from what its own coupling demands.
       A fixed tendon with range="0 1.5707963" was tried here first and does not work.
       The tendon compiles (ntendon 5, correct range) but produces zero constraint force,
       and stacking a soft limit on a DOF that an equality already determines exactly makes
       the solver blend the two: adding it drove R_Middle_DIP from +50.9 to -14.7 deg, i.e.
       further outside the limit it was supposed to enforce. MJCF has no other lever --
       ALLEX.xml is generated and must not be hand-edited, an including file cannot override
       an included joint, and these WASM bindings throw on mjModel.jnt_limited
       (memory_view<bool> is not a registered type). Hence the code-side clamp. -->

  <equality>
    <joint class="frozen" joint1="Neck_Pitch_Joint" polycoef="0.5235988 0 0 0 0"/>
    <joint class="frozen" joint1="Neck_Yaw_Joint" polycoef="0 0 0 0 0"/>

    <!-- Only the right arm and right hand are driven; everything else is frozen.
         qpos0 is 0 for all of these, so polycoef[0]=0 holds each at its
         initial angle.

         A dependent joint may NOT simply be frozen at 0. ALLEX ships 12 coupling
         constraints whose polynomials have nonzero constant terms:

           L_Index_DIP  = -0.003849 + 0.4269*PIP + ...
           L_Thumb_IP   = -0.0015   + 0.6651*MCP + ...
           Waist_Lower_Pitch = -Waist_Upper_Pitch,  = +Waist_Pitch_Dummy

         Freezing L_Index_DIP at 0 would contradict its own coupling, which wants
         -0.22 deg while its driver sits at 0.

         Freezing ONLY the drivers was tried first and is not enough. The couplings
         carry ALLEX's own solimp/solref, which are soft, so a pinned driver does
         not hold its dependent still -- measured drift over 15 s of hard right-arm
         motion was L_Thumb_IP 9.1 deg, Waist_Upper_Pitch 5.4 deg, L_Index_DIP
         4.4 deg, against 0.34 deg for a joint frozen directly. Visibly not fixed.

         So the dependents are frozen too, each at the value its coupling implies
         with the driver at 0 -- that is polycoef[0] of the coupling, since
         y = y0 + a0 and y0 = qpos0 = 0. Weld and coupling then agree numerically
         instead of fighting, and the redundancy is consistent rather than
         over-constrained. -->
    <joint class="frozen" joint1="Waist_Yaw_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="Waist_Lower_Pitch_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="Waist_Upper_Pitch_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="Waist_Pitch_Dummy_Joint" polycoef="0 0 0 0 0"/>

    <joint class="frozen" joint1="L_Shoulder_Pitch_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Shoulder_Roll_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Shoulder_Yaw_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Elbow_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Wrist_Yaw_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Wrist_Roll_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Wrist_Pitch_Joint" polycoef="0 0 0 0 0"/>

    <joint class="frozen" joint1="L_Thumb_Yaw_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Thumb_CMC_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Thumb_MCP_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Index_ABAD_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Index_MCP_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Index_PIP_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Middle_ABAD_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Middle_MCP_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Middle_PIP_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Ring_ABAD_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Ring_MCP_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Ring_PIP_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Little_ABAD_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Little_MCP_Joint" polycoef="0 0 0 0 0"/>
    <joint class="frozen" joint1="L_Little_PIP_Joint" polycoef="0 0 0 0 0"/>

    <!-- Coupled dependents, each held at its coupling's polycoef[0]. -->
    <joint class="frozen" joint1="L_Thumb_IP_Joint" polycoef="-0.0015 0 0 0 0"/>
    <joint class="frozen" joint1="L_Index_DIP_Joint" polycoef="-0.003849 0 0 0 0"/>
    <joint class="frozen" joint1="L_Middle_DIP_Joint" polycoef="-0.003849 0 0 0 0"/>
    <joint class="frozen" joint1="L_Ring_DIP_Joint" polycoef="-0.003849 0 0 0 0"/>
    <joint class="frozen" joint1="L_Little_DIP_Joint" polycoef="-0.003849 0 0 0 0"/>
  </equality>

  <contact>
    <!-- The robot is bolted to the mount; contact between them is meaningless in
         either direction. Stating it here rather than relying on geometry: the
         dense meshes happen to clear the column, but a convex collision hull of
         the waist does not (it overlapped by 50 mm), and that is a property of
         the representation, not of the scene. Scene-owned exclusions belong in
         the scene -- the generated hull file states only the robot's internal
         ones. -->
    <exclude body1="mount" body2="Base_Link"/>
    <exclude body1="mount" body2="Waist_Yaw_Link"/>
    <exclude body1="mount" body2="Waist_Lower_Pitch_Link"/>
    <exclude body1="mount" body2="Waist_Upper_Pitch_Link"/>

    <!-- The head nests between the shoulders. Sweeping Neck_Pitch x Neck_Yaw over
         their full ranges, Neck_Yaw_Link overlaps R_Shoulder_Pitch_Link by up to
         45.2 mm and L_Shoulder_Pitch_Link by up to 33.8 mm -- but only 1.9 mm at
         the rest pose, which is how the generator's rest-pose overlap test missed
         it while catching its parent Neck_Pitch_Link at 14 and 10 mm.

         Untreated this is not a cosmetic defect. Neck_Pitch_Joint carries
         actuatorfrcrange="-12 12", and the rest-pose overlap alone absorbs the
         whole budget: commanding the head down drove the servo to 157 Nm, of which
         only the clamped 12 Nm reached the joint, and the head settled at -6 deg
         instead of the commanded +30. Disabling this one geom pair takes it to
         +30.4 deg. Gravity on the head needs just 1.9 Nm, so the actuator is
         amply sized -- the contact was the entire problem. -->
    <exclude body1="Neck_Yaw_Link" body2="L_Shoulder_Pitch_Link"/>
    <exclude body1="Neck_Yaw_Link" body2="R_Shoulder_Pitch_Link"/>
  </contact>
</mujoco>
